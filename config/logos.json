{
  "roots": [
    {
      "id": "shared",
      "path": ".",
      "scope": "shared",
      "include": [
        "knowledge/shared"
      ],
      "role": "knowledge"
    },
    {
      "id": "self",
      "path": ".",
      "scope": "logos",
      "include": [
        "src",
        "test",
        "scripts"
      ],
      "role": "source"
    },
    {
      "id": "self-docs",
      "path": ".",
      "scope": "logos",
      "include": [
        "README.md",
        "AGENTS.md"
      ],
      "role": "knowledge"
    }
  ],
  "plugins": [
    {
      "module": "dist/src/extensions/quality.js",
      "enabled": true
    }
  ],
  "contextFilters": [
    "quality.applicability"
  ],
  "runners": [
    {
      "id": "local-inventory",
      "command": "node",
      "args": [
        "${workspace}/scripts/inventory-runner.mjs"
      ],
      "description": "Read-only inventory of the connected project files",
      "timeoutMs": 30000
    }
  ]
}
